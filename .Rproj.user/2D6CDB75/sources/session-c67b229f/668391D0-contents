Do PLS

```{r}
roi_index <- df[[1]]
gene_df <- df[,-1]
full_df <- data.frame(index = 1:200)
full_df <- full_df %>%
  left_join(
    cbind(index = roi_index, gene_df),
    by = "index"
  )

full_df[is.na(full_df)] <- NaN
X <- as.matrix(full_df[, -1])
y <- as.numeric(lnm_raw[[1]])
stopifnot(length(y) == nrow(X), !anyDuplicated(roi_index),
          all(roi_index %in% seq_len(nrow(X))))

valid <- is.finite(y) &
  apply(X,1,function(z) all(is.finite(z)))
X_valid <- X[valid,]
y_valid <- y[valid]

cat("Valid parcels:", sum(valid), "\n")

Xz <- scale(X_valid)
yz <- as.numeric(scale(y_valid))

pls_fit <- plsr(
  yz ~ Xz,
  ncomp=10,
  scale=FALSE
)

XS1 <- scores(pls_fit)[,1]
r <- cor(XS1,yz)
if(r<0){
  XS1 <- -XS1
  r <- -r
}

cat("PLS1 correlation =", round(r,4), "\n")
cat("R² =", round(r^2,4), "\n")

# explvar() reports X variance in percent, not LNM (response) variance.
pls1_x_variance_ratio <- unname(explvar(pls_fit)[1]) / 100
pls1_y_fitted <- as.numeric(fitted(pls_fit)[, 1, 1])
pls1_lnm_variance_ratio <- 1 - sum((yz - pls1_y_fitted)^2) /
  sum((yz - mean(yz))^2)
pls1_rho <- cor(XS1, y_valid, method = "spearman")

cat(sprintf("PLS1 explained X variance: %.6f (%.2f%%)\n",
            pls1_x_variance_ratio, 100 * pls1_x_variance_ratio))
cat(sprintf("PLS1 explained LNM variance (in-sample): %.6f (%.2f%%)\n",
            pls1_lnm_variance_ratio, 100 * pls1_lnm_variance_ratio))
cat(sprintf("PLS1 score vs LNM spatial Spearman rho: %.6f\n", pls1_rho))
```

### Spatial rotation test for PLS1 score–LNM correlation

Use the Python environment used by `neuro_transmitter.ipynb` (with
`numpy`, `nibabel`, `neuromaps`, and `brainspace`) through `reticulate`.
If needed, set `RETICULATE_PYTHON` before starting R. The left
Schaefer-400 parcels and fsaverage 10k sphere match that notebook.
Generate rotations on all 200 left parcels before applying the
expression-data mask. LNM rows must follow parcel IDs 1–200.

This two-sided test compares the **fixed observed PLS1 score map** with
rotated LNM maps. It does not refit PLS for each rotation and therefore
does not test the significance of the supervised PLS fitting procedure
or out-of-sample prediction.

```{r pls1-spin-settings}
n_spin <- 5000L
spin_seed <- 42L
atlas_lh_file <- file.path(dirname(dirname(work_dir)), "atlas",
                          "fsaverage5_lh_Schaefer2018_400Parcels_7Networks_order.label.gii")
stopifnot(file.exists(atlas_lh_file), all(is.finite(y)),
          is.finite(pls1_rho), sd(y) > 0)
```

```{python pls1-spatial-rotations}
import numpy as np
import nibabel as nib
from neuromaps.datasets import fetch_atlas
from brainspace.null_models import SpinPermutations

pls1_sphere = fetch_atlas("fsaverage", "10k")["sphere"][0]
pls1_vertices = nib.load(pls1_sphere).darrays[0].data
pls1_labels = nib.load(r.atlas_lh_file).darrays[0].data.astype(int)
if (len(pls1_labels) != len(pls1_vertices) or
        not np.array_equal(np.unique(pls1_labels[pls1_labels > 0]), np.arange(1, 201))):
    raise ValueError("Expected left parcel IDs 1–200 on the fsaverage 10k sphere.")
pls1_centroids = np.asarray([
    pls1_vertices[pls1_labels == parcel].mean(axis=0)
    for parcel in range(1, 201)
])
pls1_centroids /= np.linalg.norm(pls1_centroids, axis=1, keepdims=True)
if not np.isfinite(pls1_centroids).all():
    raise ValueError("Invalid spherical parcel centroids.")
pls1_spin = SpinPermutations(n_rep=int(r.n_spin), random_state=int(r.spin_seed))
pls1_spin.fit(pls1_centroids)
pls1_lnm_spins = pls1_spin.randomize(np.asarray(r.y, dtype=float).reshape(-1))
```

```{r pls1-spin-results}
lnm_spins <- reticulate::py$pls1_lnm_spins
stopifnot(identical(dim(lnm_spins), c(n_spin, length(y))))
spin_rho <- apply(lnm_spins[, valid, drop = FALSE], 1, function(rotated_y) {
  if (any(!is.finite(rotated_y)) || sd(rotated_y) == 0) return(NA_real_)
  cor(XS1, rotated_y, method = "spearman")
})
if (any(!is.finite(spin_rho))) {
  stop("Undefined spin correlations; inspect the rotated maps before reporting p.")
}
pls1_p_spin <- (1 + sum(abs(spin_rho) >= abs(pls1_rho))) / (n_spin + 1)

pls1_summary <- data.frame(
  component = 1L,
  n_parcels = sum(valid),
  x_explained_variance_ratio = pls1_x_variance_ratio,
  lnm_explained_variance_ratio = pls1_lnm_variance_ratio,
  rho = pls1_rho,
  p_spin = pls1_p_spin,
  n_spin = n_spin,
  seed = spin_seed,
  correlation_method = "spearman",
  alternative = "two.sided",
  spin_test = "fixed_score_map"
)
pls1_out_dir <- file.path(work_dir, "gene_expression")
dir.create(pls1_out_dir, recursive = TRUE, showWarnings = FALSE)
write.csv(pls1_summary, file.path(pls1_out_dir, "PLS1_spatial_summary.csv"),
          row.names = FALSE)
write.csv(data.frame(rotation = seq_len(n_spin), rho = spin_rho),
          file.path(pls1_out_dir, "PLS1_spatial_null_rho.csv"), row.names = FALSE)
print(pls1_summary)
cat(sprintf("PLS1 score vs LNM: Spearman rho = %.6f, spatial rotation p = %.6g (%d spins)\n",
            pls1_rho, pls1_p_spin, n_spin))
