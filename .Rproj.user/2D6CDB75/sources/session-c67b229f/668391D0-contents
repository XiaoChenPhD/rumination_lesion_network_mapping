Bootstrap

```{r}
gene_names <- colnames(Xz)
w_emp <- loading.weights(pls_fit)[, 1]
if (cor(scores(pls_fit)[, 1], yz) < 0) {
  w_emp <- -w_emp
}

bootnum <- 1000

boot_weights <- matrix(
  NA,
  nrow = ncol(Xz),
  ncol = bootnum
)

set.seed(42)

pb <- txtProgressBar(
  min = 0,
  max = bootnum,
  style = 3
)

for (i in 1:bootnum) {
  idx <- sample(
    1:nrow(Xz),
    size = nrow(Xz),
    replace = TRUE
  )
  
  fit_b <- plsr(
    yz[idx] ~ Xz[idx, ],
    ncomp = 1,
    scale = FALSE,
    validation = "none"
  )
  
  w_b <- loading.weights(fit_b)[, 1]
  
  # align bootstrap weights to empirical weights
  
  if (cor(w_emp, w_b, use = "complete.obs") < 0) {
    w_b <- -w_b
  }
  boot_weights[, i] <- w_b
  setTxtProgressBar(pb,i)
}

boot_se <- apply(
  boot_weights,
  1,
  sd,
  na.rm = TRUE
)

gene_z <- w_emp / boot_se
```

```{r}
gene_z_df <- data.frame(
  gene = gene_names,
  weight = w_emp,
  boot_se = boot_se,
  z = gene_z
)

gene_z_df <- gene_z_df[is.finite(gene_z_df$z), ]
gene_z_df <- gene_z_df[order(gene_z_df$z, decreasing = TRUE), ]
# head(gene_z_df)

sig_gene_pos <- gene_z_df$gene[gene_z_df$z > 3]
sig_gene_neg <- gene_z_df$gene[gene_z_df$z < -3]
sig_gene_abs <- gene_z_df$gene[abs(gene_z_df$z) > 3]

length(sig_gene_pos)
length(sig_gene_neg)
length(sig_gene_abs)
